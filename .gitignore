# Метаданные Windows Mark-of-the-Web, которые могут появляться как файлы в WSL/Linux
*:Zone.Identifier

# Артефакты сборки корневого Cargo workspace: Rust-проверки запускаются из корня
# репозитория, поэтому build output принадлежит корневому `target/`.
/target

# Кеш байт-кода Python от проверок `.github/scripts/`: локальный артефакт запуска,
# а не часть репозитория.
__pycache__/
*.pyc

# Пользовательские данные репозитория не публикуются через Git — ни целиком, ни
# частично. Исключений для VERIFIED-корпусов нет: owner-маркер, манифест и байты
# ресурсов существуют только в рабочей копии пользователя, поэтому отсутствие
# корпуса в чистом clone — нормальное состояние, а не повод что-то публиковать.
#
#   `decks/`        — пользовательские данные целиком: `decks/input/` — закрытая
#                     область будущего доверенного загрузчика, которую агент не
#                     читает, не просматривает и не изменяет; `decks/output/` —
#                     плоский список рабочих локальных колод, с которыми
#                     работают команды `anki-repo`. Отслеживаемым внутри
#                     `decks/` не может быть ни один путь, а не только эти две
#                     области: прежняя раскладка с каталогами группировки —
#                     состояние прошлых ревизий, а не контракт;
#   `.asset-store/` — локальное доверенное хранилище ресурсов.
/decks/
/.asset-store/

# Каталог статического отчёта `anki-repo visual-report`: это результат единичного
# прогона (сотни файлов превью и копий media), а не данные репозитория. Каталог
# отчёта обязан лежать вне `decks/**` и не попадать в коммит; эти имена
# зафиксированы как соглашение, чтобы прогон рядом с репозиторием не всплывал в
# `git status`.
/visual-report/
/report/

# Repository-local рабочие артефакты агента — например Markdown-источник body
# текущего PR (`/.codex/local/pr/<task>/body.md`). Это не публикуемый контракт
# репозитория и не tracked: процедуру владеет `.agents/skills/anki-git-workflow/`.
/.codex/local/
