{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": [
    "Постоянная политика dependency maintenance: поддерживать зависимости и GitHub Actions актуальными без автоматического merge.",
    "Использовать рекомендации Renovate для pin digest, config migrations, abandoned dependency detection и регулярного обслуживания lock-файлов.",
    "Обычные обновления, включая major, проходят через ограниченный PR/CI budget; security updates получают отдельный быстрый канал.",
    "Версии Rust workspace MSRV и rustup обновляются вместе через официальный Rust datasource, только по завершённым stable-релизам."
  ],
  "extends": [
    "config:best-practices"
  ],
  "dependencyDashboard": true,
  "dependencyDashboardApproval": false,
  "automerge": false,
  "prConcurrentLimit": 4,
  "prHourlyLimit": 2,
  "commitHourlyLimit": 2,
  "separateMultipleMajor": false,
  "vulnerabilityAlerts": {
    "enabled": true,
    "dependencyDashboardApproval": false,
    "prConcurrentLimit": 1
  },
  "rebaseWhen": "behind-base-branch",
  "packageRules": [
    {
      "description": "Обе версии Rust должны обновляться совместно, без beta/nightly и без захвата crates",
      "matchManagers": [
        "rust-toolchain",
        "custom.regex"
      ],
      "matchDatasources": [
        "rust-version"
      ],
      "matchPackageNames": [
        "rust"
      ],
      "groupName": "Rust stable toolchain",
      "rangeStrategy": "replace",
      "allowedVersions": "/^\\d+\\.\\d+\\.\\d+$/",
      "automerge": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "MSRV только из [workspace.package] корневого Cargo.toml",
      "managerFilePatterns": [
        "/^Cargo\\.toml$/"
      ],
      "matchStringsStrategy": "recursive",
      "matchStrings": [
        "(?:^|\\r?\\n)\\[workspace\\.package\\][ \\t]*(?:#[^\\r\\n]*)?(?:\\r?\\n[ \\t]*(?:#[^\\r\\n]*|[A-Za-z][A-Za-z0-9_-]*[ \\t]*=[^\\r\\n]*|[^ \\t\\[\\r\\n][^\\r\\n]*)?)*",
        "(?:^|\\r?\\n)[ \\t]*rust-version[ \\t]*=[ \\t]*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "rust",
      "datasourceTemplate": "rust-version",
      "versioningTemplate": "rust-release-channel"
    }
  ]
}
